{
  "schemaVersion": 1,
  "id": "hotbarpockets",
  "version": "${version}",
  "name": "Hotbar Pockets",
  "icon": "assets/hotbarpockets/icon.png",
  "description": "Up to three extra slots behind each hotbar slot, and a key that rotates them into your hand. Goes with Inventory Plus.",
  "authors": [
    "trevorschoeny"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/hotbar-pockets",
    "sources": "https://github.com/trevorschoeny/hotbar-pockets"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.trevorschoeny.hotbarpockets.HotbarPockets"
    ],
    "client": [
      "com.trevorschoeny.hotbarpockets.HotbarPocketsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "menukit": ">=7.4.0 <8.0.0",
    "slotkit": ">=2.1.0 <3.0.0"
  },
  "suggests": {
    "inventoryplus": "*"
  },
  "breaks": {
    "inventoryplus": "<3.3.0"
  },
  "custom": {
    "slotkit": {
      "bothSides": "required"
    }
  }
}
